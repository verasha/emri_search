#!/bin/bash
#PBS -P CFP03-CF-051
#PBS -o logs/sobol_noise_tpmax.out
#PBS -e logs/sobol_noise_tpmax.err
#PBS -N sobol_noise_tpmax
#PBS -l walltime=24:00:00
