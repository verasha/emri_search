cd $PBS_O_WORKDIR

mkdir -p logs
module load cuda12.4/toolkit/12.4.1
source /home/svu/e1498138/emri_search_uv/.venv/bin/activate

python -u run_sobol_noise.py --n-samples 100000 --batch-size 10 --outdir /scratch/e1498138/sobol/noise/tpmax/ckpt_1e5

echo "Job completed at $(date)"
